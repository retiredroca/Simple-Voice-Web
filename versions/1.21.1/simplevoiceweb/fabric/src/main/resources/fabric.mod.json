{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Join a server's Simple Voice Chat proximity voice from a browser. Players without the mod get a keyed, single-use link and speak through a web page.",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.retiredroca.svcweb.fabric.SimpleVoiceWebFabric"
    ],
    "voicechat": [
      "com.retiredroca.svcweb.fabric.common.voice.VoiceWebPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "voicechat_api": ">=${voicechat_api_version}"
  }
}
